#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/singbox-managerd

service_triggers() {
	procd_add_reload_trigger "singbox-manager"
}

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn 3600 5 5
	# On SIGTERM the daemon stops sing-box (up to 5s) and reloads fw4; the
	# default 5s would SIGKILL it mid-teardown and leave the data path installed.
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Teardown must not run in stop_service: the daemon is still alive then, and its
# supervisor restarts sing-box (re-applying firewall and routing) as soon as a
# separate cleanup kills it. The daemon tears down on SIGTERM instead.
stop_service() {
	:
}

daemon_running() {
	local cmdline
	for cmdline in /proc/[0-9]*/cmdline; do
		[ "$(tr '\0' ' ' < "$cmdline" 2>/dev/null)" = "$PROG serve " ] && return 0
	done
	return 1
}

# Safety net once procd has signalled the daemon: wait for it to exit, then
# remove anything it left behind (an orphaned sing-box, nft rules, policy routes).
service_stopped() {
	local i=0
	while daemon_running && [ "$i" -lt 35 ]; do
		sleep 1
		i=$((i + 1))
	done
	"$PROG" cleanup >/dev/null 2>&1 || true
}

reload_service() {
	procd_send_signal singbox-managerd
}
